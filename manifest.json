{
  "manifest_version": 3,
  "name": "IVOL Agent",
  "version": "0.6.0",
  "description": "ChatGPT-агент в боковой панели: читает страницу, видит её глазами, заполняет формы, кликает, ищет в вебе и выполняет скрипты — с подтверждением каждого действия.",
  "permissions": ["storage", "sidePanel", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "IVOL Agent"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
